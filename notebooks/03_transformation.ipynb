      "source": [
        "# KDD Stage 3 — Transformation\n",
        "\n",
        "Builds the two model inputs: `X_seq` (LSTM branch: rolling time-series features including\n",
        "the antecedent precipitation index and land-cover composition) and `X_tile` (CNN branch:\n",
        "satellite tiles), aligned per (region, day), with a fixed lookback window."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "c726413d",
      "metadata": {},
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import hashlib, json\n",
        "from pathlib import Path\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "SEED = 42\n",
        "LOOKBACK = 10\n",
        "PROC = Path(\"../data/processed\")\n",
        "RAW = Path(\"../data/raw\")\n",
        "\n",
        "stations = pd.read_parquet(PROC / \"station_readings_clean.parquet\")\n",
        "land_cover = pd.read_parquet(PROC / \"land_cover_clean.parquet\").set_index(\"region_id\")\n",
        "tiles_npz = np.load(RAW / \"satellite_tiles.npz\")\n",
        "\n",
        "FEATURES = [\"rainfall_mm_24h\", \"river_level_m\", \"soil_moisture\", \"temperature_c\", \"humidity_pct\"]\n",
        "MISSING_FLAGS = [f\"{c}_missing\" for c in FEATURES]\n",
        "LC = [\"urban_pct\", \"water_pct\", \"vegetation_pct\", \"bare_pct\"]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "f5ed2596",
      "metadata": {},
      "outputs": [],
      "source": [
        "def api_index(rainfall: np.ndarray, decay: float = 0.9) -> np.ndarray:\n",
        "    api = np.zeros_like(rainfall)\n",
        "    for i in range(1, len(rainfall)):\n",
        "        api[i] = decay * api[i - 1] + rainfall[i]\n",
        "    return api\n",
        "\n",
        sequences, tile_inputs, labels, meta = [], [], [], []
for region_id, df in stations.groupby("region_id"):
    df = df.sort_values("date").reset_index(drop=True)
    df["api_index"] = api_index(df["rainfall_mm_24h"].values)
    lc_row = land_cover.loc[region_id, LC].values.astype("float32")
    tiles = tiles_npz[region_id]
    feat_cols = FEATURES + ["api_index"] + MISSING_FLAGS
    values = df[feat_cols].values.astype("float32")
    data_source = df["data_source"].iloc[0] if "data_source" in df.columns else "unknown"

    for i in range(LOOKBACK, len(df)):
        window = values[i - LOOKBACK:i]
        lc_tiled = np.tile(lc_row, (LOOKBACK, 1))
        sequences.append(np.concatenate([window, lc_tiled], axis=1))
        tile_inputs.append(tiles[i])
        labels.append(int(df["flood_label"].iloc[i]))
        meta.append((region_id, str(df["date"].iloc[i].date()), data_source))

meta_df = pd.DataFrame(meta, columns=["region_id", "date", "data_source"])
meta_df.to_parquet(PROC / "sample_meta.parquet", index=False)
