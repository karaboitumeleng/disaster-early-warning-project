   "source": [
    "fig, axes = plt.subplots(1, len(m[\"models\"]), figsize=(4 * len(m[\"models\"]), 3.6))\n",
    "for ax, (name, v) in zip(np.atleast_1d(axes), m[\"models\"].items()):\n",
