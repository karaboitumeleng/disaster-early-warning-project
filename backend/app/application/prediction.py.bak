import logging

from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker

from app.application.alerts import AlertService
from app.events import DataIngested
from app.feeds import FeedMonitor
from app.ml.predictor import ModelRegistry
from app.repositories import AuditRepo

log = logging.getLogger(__name__)


class PredictionService:
    def __init__(
        self,
        registry: ModelRegistry,
        alerts: AlertService,
        session_factory: async_sessionmaker[AsyncSession],
        feeds: FeedMonitor | None = None,
    ) -> None:
        self.registry = registry
        self.alerts = alerts
        self.session_factory = session_factory
        self.feeds = feeds

    async def on_data_ingested(self, event: DataIngested) -> None:
        features = event.reading.features()
        if self.feeds is not None and not self.feeds.is_up("satellite"):
            # Graceful degradation: ignore satellite-derived inputs, predict from ground data.
            features = {**features, "ndwi_mean": None}
        pred = self.registry.active().predict(event.reading.region_id, features)
        async with self.session_factory() as s:
            await AuditRepo(s).record(
                "system",
                "prediction",
                {
                    "region": pred.region_id,
                    "score": pred.risk_score,
                    "confidence": pred.confidence,
                    "model": pred.model_version,
                    "degraded": pred.degraded,
                    "novel": pred.novel,
                },
            )
        await self.alerts.evaluate(pred, event.reading_hash, event.received_at)
        log.info(
            "prediction complete",
            extra={"ctx": {"region": pred.region_id, "score": pred.risk_score}},
        )