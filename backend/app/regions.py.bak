    Region("KZN-UTHUKELA", "uThukela (Ladysmith)", "KwaZulu-Natal", -28.56, 29.78),
    Region("KZN-KING-CETSHWAYO", "King Cetshwayo (Richards Bay)", "KwaZulu-Natal", -28.78, 32.04),
    Region("MP-EHLANZENI", "Ehlanzeni (Mbombela)", "Mpumalanga", -25.47, 30.98),
    Region("MP-GERT-SIBANDE", "Gert Sibande (Ermelo)", "Mpumalanga", -26.53, 29.98),
